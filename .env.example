VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Optional: set this when the API is hosted on a different origin than the app.
# Leave empty during local development (Vite proxies /api to the backend).
VITE_API_URL=

# Google SSO: same OAuth 2.0 Web Client ID used by the backend.
# Leave empty to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
